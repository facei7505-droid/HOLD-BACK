# Local demo server (app/server.js). Copy to .env, then run `npm run demo`
# (it starts `node --env-file=.env app/server.js`).
# Never commit a real wallet or keypair: the server creates throwaway role wallets itself.

# Solana RPC endpoint: local validator by default, or https://api.devnet.solana.com
RPC_URL=http://127.0.0.1:8899

# HTTP port of the demo UI
PORT=3000

# Demo warranty length in seconds (2 years in real life)
WARRANTY_SECS=55

# How long after the warranty the arbiter may still settle an open defect
ARBITER_WINDOW_SECS=3600

# Tests (npm test) read the provider from these
ANCHOR_PROVIDER_URL=http://127.0.0.1:8899
ANCHOR_WALLET=~/.config/solana/id.json
